[Unit]
Description=ccxpbx - Poly CCX500 provisioning and PBX manager
After=network-online.target asterisk.service
Wants=network-online.target

[Service]
Type=simple
User=ccxpbx
Group=ccxpbx
SupplementaryGroups=asterisk
EnvironmentFile=/etc/ccxpbx/ccxpbx.env
WorkingDirectory=/opt/ccxpbx/manager
ExecStart=/opt/ccxpbx/venv/bin/python -m uvicorn ccxpbx.main:app --host 0.0.0.0 --port ${CCXPBX_HTTP_PORT} --no-server-header --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0027
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ccxpbx /etc/asterisk/ccxpbx

[Install]
WantedBy=multi-user.target
