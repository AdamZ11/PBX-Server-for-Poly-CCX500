[Unit]
Description=Asterisk PBX (ccxpbx)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=asterisk
Group=asterisk
RuntimeDirectory=asterisk
RuntimeDirectoryMode=0775
ExecStart=/usr/sbin/asterisk -f -C /etc/asterisk/asterisk.conf
ExecReload=/usr/sbin/asterisk -rx 'core reload'
ExecStop=/usr/sbin/asterisk -rx 'core stop gracefully'
# "always": also comes back if "core restart" from the web UI makes the process exit
Restart=always
RestartSec=5
LimitNOFILE=16384
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SYS_NICE
Nice=-5

[Install]
WantedBy=multi-user.target
